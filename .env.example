# Environment Configuration Example
# Copy this file to .env and adjust values for your local or production environment.

# Flask Application Secret Key (Used for CSRF and signing)
SECRET_KEY=change_this_to_a_long_random_cryptographic_secret_key

# Database Connection Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=OnlineExaminationDB

# Alternatively, specify a direct connection string (e.g., for SQLite testing)
# DATABASE_URL=sqlite:///online_examination.db

# Secure Session Management Settings
SESSION_COOKIE_NAME=session_id
SESSION_LIFETIME_MINUTES=60
# Set SESSION_COOKIE_SECURE=True in production with HTTPS
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
SESSION_REFRESH_THRESHOLD_MINUTES=15
